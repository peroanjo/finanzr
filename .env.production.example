FINANZR_VERSION=local
POSTGRES_DB=finanzr
POSTGRES_USER=finanzr
POSTGRES_PASSWORD=replace-with-a-long-random-value
DJANGO_SECRET_KEY=replace-with-a-long-random-value
EXTERNAL_CREDENTIALS_KEY=replace-with-a-fernet-key
DJANGO_ALLOWED_HOSTS=demo-finanzr.example.com,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://demo-finanzr.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
API_RATE_LIMIT=300
API_SENSITIVE_RATE_LIMIT=20
LAN_BIND_ADDRESS=127.0.0.1
LAN_HTTP_PORT=8080
